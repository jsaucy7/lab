    "apiEnvironment": "Shared",
    "isCustomApi": true,
    "blobUrisAreProxied": false,
    "connectionParameters": {},
    "swagger": {
      "swagger": "2.0",
      "info": {
        "title": "Open Food Facts",
        "description": "Look up product data (name, brand, quantity, image) by barcode from the Open Food Facts public database. No API key required.",
        "version": "1.0"
      },
      "host": "fc5379522d6ee0059ac6353bc34f0e.13.environment.api.powerplatform.com",
      "basePath": "/connectors/runtime/invoke/scalegroups/usa002/shards/18/apis/lab-5fopen-20food-20facts-5fcc24a7c31c0e2b2c/connections/",
      "schemes": [
        "https"
      ],
      "consumes": [],
      "produces": [
        "application/json"
      ],
      "paths": {
        "/{connectionId}/product/{barcode}.json": {
          "get": {
            "summary": "Get product by barcode",
            "description": "Looks up a product by its EAN/UPC barcode and returns its name, brand, quantity, and image URL.",
            "operationId": "GetProductByBarcode",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "barcode",
                "in": "path",
                "required": true,
                "type": "string",
                "description": "The product's EAN-13 or UPC-A barcode.",
                "x-ms-summary": "Barcode"
              }
            ],
            "responses": {
              "200": {
                "description": "Product found",
                "schema": {
                  "$ref": "#/definitions/Product"
                }
              },
              "404": {
                "description": "No product found for this barcode"
              }
            }
          }
        },
        "/{connectionId}/product-image": {
          "get": {
            "summary": "Get product image",
            "description": "Proxies the bytes of an image URL returned by GetProductByBarcode.",
            "operationId": "GetProductImage",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "imageUrl",
                "in": "query",
                "required": true,
                "type": "string",
                "description": "The image URL returned by GetProductByBarcode.",
                "x-ms-summary": "Image URL"
              }
            ],
            "produces": [
              "image/jpeg",
              "image/png"
            ],
            "responses": {
              "200": {
                "description": "Image bytes",
                "schema": {
                  "type": "file"
                }
              },
              "400": {
                "description": "imageUrl query parameter is required"
              }
            },
            "x-ms-media-kind": "image"
          }
        }
      },
      "definitions": {
        "Product": {
          "type": "object",
          "properties": {
            "ean": {
              "type": "string",
              "description": "The barcode that was looked up.",
              "x-ms-summary": "EAN"
            },
            "name": {
              "type": "string",
              "description": "The product's name.",
              "x-ms-summary": "Name"
            },
            "brand": {
              "type": "string",
              "description": "The product's brand.",
              "x-ms-summary": "Brand"
            },
            "quantity": {
              "type": "string",
              "description": "Free-text package quantity, such as 400 g or 330 ml.",
              "x-ms-summary": "Quantity"
            },
            "imageUrl": {
              "type": "string",
              "description": "URL of the product image.",
              "x-ms-summary": "Image URL"
            }
          }
        }
      },
